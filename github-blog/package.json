{
  "name": "github-blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "bun ./node_modules/@angular/cli/bin/ng.js",
    "start": "bun ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "bun ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "bun ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test",
    "content:build": "bun scripts/build-content.mjs",
    "prebuild": "bun run content:build",
    "prestart": "bun run content:build",
    "prewatch": "bun run content:build",
    "pretest": "bun run content:build",
    "test:content": "bun test ./scripts/build-content.test.mjs",
    "test:routes": "bun run content:build && node ./node_modules/@angular/cli/bin/ng.js test --karma-config karma.conf.cjs --watch=false --browsers=ChromeHeadless --include=src/app/routing-compatibility.spec.ts",
    "test:ui": "bun run content:build && node ./node_modules/@angular/cli/bin/ng.js test --karma-config karma.conf.cjs --watch=false --browsers=ChromeHeadless --include=src/app/notebook-ui.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "@tensorflow/tfjs": "^4.22.0",
    "ng2-pdf-viewer": "10.4.0",
    "ngx-highlight-js": "21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "0.16.3",
    "@angular/cdk": "21.2.14"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.31",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@types/jasmine": "~4.3.6",
    "jasmine-core": "~4.6.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.5",
  "overrides": {
    "glob@^13.0.0": "14.0.6",
    "minimatch@^10.1.1": "11.0.9",
    "minimatch@^10.0.3": "11.0.9",
    "minimatch@^10.2.2": "11.0.9",
    "uuid": "11.1.1"
  }
}
